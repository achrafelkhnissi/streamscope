{
  "name": "streamscope",
  "displayName": "Streamscope: HTTP Client with Live Streaming",
  "description": "Send requests from .http files and watch streaming responses (NDJSON, SSE, LLM streams) arrive event by event. Capture values from any event and reuse them.",
  "version": "0.0.1",
  "publisher": "achrafelkhnissi",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/achrafelkhnissi/streamscope.git"
  },
  "bugs": {
    "url": "https://github.com/achrafelkhnissi/streamscope/issues"
  },
  "homepage": "https://github.com/achrafelkhnissi/streamscope#readme",
  "preview": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "http",
    "rest",
    "rest client",
    "api",
    "sse",
    "server-sent events",
    "ndjson",
    "streaming",
    "llm",
    "agent",
    "ag-ui",
    "api testing"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/format-worker.js",
    "syntaxes/http.tmLanguage.json",
    "language-configuration.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "streamscope.sendRequest",
        "title": "Send Request",
        "category": "Streamscope",
        "icon": "$(play)"
      },
      {
        "command": "streamscope.stopRequest",
        "title": "Stop Request",
        "category": "Streamscope",
        "icon": "$(debug-stop)"
      },
      {
        "command": "streamscope.saveResponse",
        "title": "Save Response",
        "category": "Streamscope",
        "icon": "$(save)"
      },
      {
        "command": "streamscope.showResponseHeaders",
        "title": "Show Response Headers",
        "category": "Streamscope",
        "icon": "$(list-flat)"
      },
      {
        "command": "streamscope.showResponseBody",
        "title": "Show Response Body",
        "category": "Streamscope",
        "icon": "$(file-code)"
      },
      {
        "command": "streamscope.showLog",
        "title": "Show Log",
        "category": "Streamscope"
      }
    ],
    "keybindings": [
      {
        "command": "streamscope.sendRequest",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == http && resourceScheme != streamscope-response"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "streamscope.sendRequest",
          "when": "editorLangId == http && resourceScheme != streamscope-response"
        },
        {
          "command": "streamscope.stopRequest",
          "when": "editorLangId == http || resourceScheme == streamscope-response"
        },
        {
          "command": "streamscope.saveResponse",
          "when": "editorLangId == http || resourceScheme == streamscope-response"
        },
        {
          "command": "streamscope.showResponseHeaders",
          "when": "editorLangId == http || resourceScheme == streamscope-response"
        },
        {
          "command": "streamscope.showResponseBody",
          "when": "editorLangId == http || resourceScheme == streamscope-response"
        }
      ],
      "editor/title": [
        {
          "command": "streamscope.showResponseHeaders",
          "when": "resourceScheme == streamscope-response && !(resourceFilename =~ /\\.headers\\.http$/)",
          "group": "navigation@1"
        },
        {
          "command": "streamscope.showResponseBody",
          "when": "resourceScheme == streamscope-response && resourceFilename =~ /\\.headers\\.http$/",
          "group": "navigation@1"
        },
        {
          "command": "streamscope.saveResponse",
          "when": "resourceScheme == streamscope-response",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Streamscope",
      "properties": {
        "streamscope.request.connectTimeout": {
          "type": "string",
          "default": "30s",
          "pattern": "^\\d+(ms|s|m)$",
          "patternErrorMessage": "Use a duration such as 500ms, 30s or 5m.",
          "markdownDescription": "How long to wait for the connection, including the TLS handshake, before giving up. A duration such as `500ms`, `30s` or `5m`."
        },
        "streamscope.request.headersTimeout": {
          "type": "string",
          "default": "300s",
          "pattern": "^\\d+(ms|s|m)$",
          "patternErrorMessage": "Use a duration such as 500ms, 30s or 5m.",
          "markdownDescription": "How long to wait for the response headers once connected. A duration such as `500ms`, `30s` or `5m`. Use `# @timeout` on a request to limit its total time."
        },
        "streamscope.request.followRedirects": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Follow redirects. Use `# @no-redirect` to turn this off for one request."
        },
        "streamscope.request.maxRedirects": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "markdownDescription": "The most redirects to follow for one request."
        },
        "streamscope.request.caFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "A PEM file of extra certificate authorities to trust, added to the default and system ones. An absolute path, or a path relative to the workspace folder."
        },
        "streamscope.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Send Request and the last outcome above each request."
        }
      }
    },
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http.streamscope",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "watch:types": "tsc --noEmit --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project test/unit/tsconfig.json && tsc --noEmit --project test/integration/tsconfig.json && tsc --noEmit --project test/vsix/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "compile:host-tests": "tsc --project test/integration/tsconfig.json && tsc --project test/vsix/tsconfig.json",
    "test:integration": "npm run build && npm run compile:host-tests && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "vscode:prepublish": "npm run build:production",
    "package": "vsce package --no-dependencies",
    "package:list": "vsce ls --tree --no-dependencies",
    "verify:vsix": "npm run package && npm run compile:host-tests && node scripts/verify-vsix.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
