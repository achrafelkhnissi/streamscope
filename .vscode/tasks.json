{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "dependsOn": ["npm: watch", "npm: watch:types"],
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": "build",
      "presentation": { "group": "watch", "reveal": "never" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": [
          { "regexp": "^✘ \\[(ERROR|WARNING)\\] (.*)$", "severity": 1, "message": 2 },
          { "regexp": "^\\s+(.*):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
        ],
        "background": {
          "activeBegins": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    },
    {
      "label": "npm: watch:types",
      "type": "npm",
      "script": "watch:types",
      "isBackground": true,
      "group": "build",
      "presentation": { "group": "watch", "reveal": "never" },
      "problemMatcher": "$tsc-watch"
    }
  ]
}
