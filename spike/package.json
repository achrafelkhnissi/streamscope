{
  "name": "streamscope-spike",
  "displayName": "Streamscope response view spike",
  "description": "Throwaway response view prototypes for milestone M5.",
  "version": "0.0.0",
  "publisher": "achrafelkhnissi",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "streamscope.benchmark.stream",
        "title": "Benchmark Stream",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.benchmark.walkthrough",
        "title": "Benchmark Walkthrough",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.open",
        "title": "Open Stream…",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.showEvents",
        "title": "Events",
        "category": "Streamscope Spike",
        "icon": "$(list-unordered)"
      },
      {
        "command": "streamscope.spike.showReply",
        "title": "Reply",
        "category": "Streamscope Spike",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "streamscope.spike.showRaw",
        "title": "Raw",
        "category": "Streamscope Spike",
        "icon": "$(code)"
      },
      {
        "command": "streamscope.spike.showHeaders",
        "title": "Headers",
        "category": "Streamscope Spike",
        "icon": "$(list-flat)"
      },
      {
        "command": "streamscope.spike.showBody",
        "title": "Body",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.showChecks",
        "title": "Checks",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.showDetail",
        "title": "Show Event Detail",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.showOlder",
        "title": "Show Older Events",
        "category": "Streamscope Spike"
      },
      {
        "command": "streamscope.spike.stop",
        "title": "Stop",
        "category": "Streamscope Spike",
        "icon": "$(debug-stop)"
      },
      {
        "command": "streamscope.spike.capture",
        "title": "Capture This Value…",
        "category": "Streamscope Spike"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "streamscope.spike.stop",
          "when": "resourceScheme =~ /^streamscope-spike/ && streamscope.spikeRunning",
          "group": "navigation@0"
        },
        {
          "command": "streamscope.spike.showEvents",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "navigation@1"
        },
        {
          "command": "streamscope.spike.showReply",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "navigation@2"
        },
        {
          "command": "streamscope.spike.showRaw",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "navigation@3"
        },
        {
          "command": "streamscope.spike.showHeaders",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "navigation@4"
        },
        {
          "command": "streamscope.spike.showBody",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "views@1"
        },
        {
          "command": "streamscope.spike.showChecks",
          "when": "resourceScheme =~ /^streamscope-spike/",
          "group": "views@2"
        }
      ],
      "editor/context": [
        {
          "command": "streamscope.spike.showDetail",
          "when": "resourceExtname == .streamscope-events",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "streamscope.spike.showDetail",
        "key": "enter",
        "when": "editorTextFocus && resourceExtname == .streamscope-events"
      }
    ],
    "languages": [
      {
        "id": "streamscope-events",
        "aliases": [
          "Streamscope Events"
        ],
        "extensions": [
          ".streamscope-events"
        ]
      }
    ],
    "grammars": [
      {
        "language": "streamscope-events",
        "scopeName": "source.streamscope-events",
        "path": "./syntaxes/events.tmLanguage.json"
      }
    ]
  }
}
